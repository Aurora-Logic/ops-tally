{
  "name": "@opstally/agent",
  "version": "1.0.0",
  "description": "OpsTally Agent — fires Tally Prime data at your webhook",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "test": "npm run rebuild:node && vitest run",
    "dist": "npm run rebuild:electron && electron-vite build && electron-builder --win",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 --version 38.8.6",
    "rebuild:node": "npm rebuild better-sqlite3 --prefix ../.."
  },
  "dependencies": {
    "@opstally/tally-client": "*",
    "better-sqlite3": "^12.2.0",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "xml2js": "^0.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "38.8.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
