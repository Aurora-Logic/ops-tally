{
  "name": "@opstally/tally-client",
  "version": "1.0.0",
  "description": "Tally Prime XML gateway client — queries, parsers, price resolvers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
