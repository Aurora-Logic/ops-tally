  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "probe": "tsx src/probe.ts"
  },
  "dependencies": {
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
